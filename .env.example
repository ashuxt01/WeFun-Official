# Optional External Real-Time Voice / Chat Credentials
# Configure these in the Secrets panel in AI Studio for production RTC connectivity.
# Without these keys, WEFUN runs in Local Mic VAD + Interactive Room Simulation Mode.
# TRTC_SDK_APP_ID=0
# TRTC_SDK_SECRET=YOUR_TRTC_SDK_SECRET
# LIVEKIT_WS_URL=wss://your-livekit-instance.livekit.cloud
# LIVEKIT_TOKEN_API_URL=https://your-token-server.example.com/rtc/token
